# Cloud Run environment for the FairFine backend.
#
# 1. Copy this file to `env.yaml`  (env.yaml is gitignored — it holds real keys)
# 2. Paste your real values below
# 3. Deploy with:  --env-vars-file env.yaml   (see docs/RUNBOOK.md)
#
# Using a file instead of --set-env-vars keeps a 176-char Qdrant key out of your
# shell history and avoids the comma-delimiter footgun.

GEMINI_API_KEY: "paste-your-gemini-key"

# Free-tier friendly: run the whole pipeline on Flash (matches your local .env).
AUDITOR_MODEL: "gemini-2.5-flash"
CITIZEN_MODEL: "gemini-2.5-flash"

# Fewer frames per event = less quota burned per audit.
FRAMES_PER_EVENT: "3"

# Semantic memory. Omit these two lines to use the in-process fallback instead.
QDRANT_URL: "https://your-endpoint.us-west-2-0.aws.cloud.qdrant.io"
QDRANT_API_KEY: "paste-your-qdrant-database-key"
QDRANT_COLLECTION: "fairfine"

# Set to your Vercel URL AFTER the frontend is deployed (step 6). Start as "*".
CORS_ORIGINS: "*"

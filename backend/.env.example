# --- FairFine backend ---
# Every key below is OPTIONAL. With none of them set, the pipeline runs in
# `simulation` mode: a deterministic rule engine stands in for the models, and
# the UI labels the mode honestly on every screen. Add GEMINI_API_KEY to switch
# the whole pipeline to live Gemini inference.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Model selection ---
# Defaults follow the PRD's locked stack: Flash for perception, Pro for the audit.
#   DETECTOR_MODEL=gemini-2.5-flash
#   PLATE_MODEL=gemini-2.5-flash
#   AUDITOR_MODEL=gemini-2.5-pro
#   CITIZEN_MODEL=gemini-2.5-pro
#
# ON A FREE API KEY: gemini-2.5-pro has a much tighter free quota than Flash and
# is the first thing you will hit a 429 on. Uncomment the two lines below to run
# the whole pipeline on Flash. The auditor's reasoning gets shallower, but every
# verdict rule, threshold and check behaves identically.
# AUDITOR_MODEL=gemini-2.5-flash
# CITIZEN_MODEL=gemini-2.5-flash

# Qdrant Cloud (semantic memory: duplicate detection + MV Act RAG).
# Without this an in-process cosine index serves the same interface.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=fairfine

# Enkrypt AI (PII redaction + bias screening).
# Without this a local regex redactor enforces the same guarantee.
ENKRYPT_API_KEY=

DATABASE_URL=sqlite:///./fairfine.db

# Comma-separated origins, or * for any.
CORS_ORIGINS=*

# --- Decision thresholds (these are the auditor's actual rules) ---
ISSUE_TRUST_THRESHOLD=0.90
ESCALATE_TRUST_FLOOR=0.60
PLATE_CONFIDENCE_FLOOR=0.85
DUPLICATE_WINDOW_SECONDS=60
FRAMES_PER_EVENT=5
EVENT_WINDOW_SECONDS=3
